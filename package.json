    "mobile:open": "npx cap open android",
    "mobile:apk": "cd android && .\\gradlew.bat assembleDebug"
  },
  "keywords": ["reminder", "feishu", "serverchan", "pwa"],
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/edge": "^1.3.1",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2"
  }
}
