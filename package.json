{
  "name": "nudge",
  "version": "4.1.31",
  "description": "Nudge — 轻推一下，刚好想起",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "reminder": "node reminder.js",
    "feishu:ws": "node feishu-ws.js",
    "test": "node --test --test-concurrency=1 test/*.js",
