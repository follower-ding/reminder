# Postgres（Vercel 生产必填；Neon / Vercel Postgres 连接串）
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# DeepSeek（仅服务端；禁止提交真实 Key）
# DEEPSEEK_API_KEY=sk-...

# 飞书企业自建应用（收消息 / 对话 / 回复「收到」确认）
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_VERIFICATION_TOKEN=可选（HTTP 回调用；长连接可不填）
# FEISHU_CHAT_ID=可选；不填则在群里 @Nudge 后自动写入 config.feishu.chat_id
#
# 【推荐】事件订阅选「使用长连接接收事件」（Vercel 公网 URL 易被飞书 3s 超时）
# 常驻进程（本机或 VPS）：
#   npm run feishu:ws
# 连上后再在飞书后台保存「长连接」并添加 im.message.receive_v1
#
# 【不推荐】HTTP：https://your-app.vercel.app/api/feishu/event（国内访问常超时）

# 公网入口（事项卡无文档时「打开清单」仍可回网页）
# APP_URL=http://49.235.172.214:9999
# APP_VERSION=4.1.21
# PORT=9999
#
# 订阅精选写入飞书云文档（短卡 +「阅读全文」打开文档）
# 应用需开通：docx:document、docx:document.block:convert、云文档权限管理
# FEISHU_DOC_FOLDER_TOKEN=fldxxx   # 可选，文档存放文件夹
# FEISHU_DOC_BASE=https://www.feishu.cn/docx
# 长连接还需回调：card.action.trigger

# 可选：覆盖 HMAC 登录 / 飞书「已收到」深链签名密钥（生产务必改）
# TOKEN_SECRET=change-me

# 可选：保护 /api/cron/check（VPS 定时或外部 cron 时建议设置）
# CRON_SECRET=random-long-string

# 本地开发可不用 DATABASE_URL，将使用项目目录 data.json / config.json
