# Postgres（Vercel 生产必填；Neon / Vercel Postgres 连接串）
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# DeepSeek（仅服务端；禁止提交真实 Key）
# DEEPSEEK_API_KEY=sk-...

# 飞书企业自建应用（收消息 / 对话 / 回复「收到」确认）
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_VERIFICATION_TOKEN=可选-事件校验Token
# 事件订阅请求地址：https://your-app.vercel.app/api/feishu/event

# 飞书卡片「打开清单」链接
# APP_URL=https://your-app.vercel.app

# 可选：覆盖 HMAC 登录签名密钥
# TOKEN_SECRET=change-me

# 本地开发可不用 DATABASE_URL，将使用项目目录 data.json / config.json
